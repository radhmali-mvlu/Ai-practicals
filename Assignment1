1. BREADTH-FIRST SEARCH (BFS)
print("\n========== BFS ==========")
queue = deque([(start, [start], 0)])
visited = set()
nodes = 0
while queue:
    node, path, total_cost = queue.popleft()
    nodes += 1
    if node == goal:
        print("Path:", " -> ".join(path))
        print("Total Cost:", total_cost, "km")
        print("Nodes Explored:", nodes)
        break
    if node not in visited:
        visited.add(node)
        for neighbor, edge_cost in graph[node]:
            if neighbor not in visited:
                queue.append(
                    (
                        neighbor,
                        path + [neighbor],
                        total_cost + edge_cost
                    )
                )


# 2. DEPTH-FIRST SEARCH (DFS)
print("\n========== DFS ==========")
stack = [(start, [start], 0)]
visited = set()
nodes = 0
while stack:
    node, path, total_cost = stack.pop()
    nodes += 1
    if node == goal:
        print("Path:", " -> ".join(path))
        print("Total Cost:", total_cost, "km")
        print("Nodes Explored:", nodes)
        break
    if node not in visited:
        visited.add(node)
        for neighbor, edge_cost in reversed(graph[node]):
            stack.append(
                (
                    neighbor,
                    path + [neighbor],
                    total_cost + edge_cost
                )
            )


# 3. UNIFORM COST SEARCH (UCS)
print("\n========== UCS ==========")
pq = [(0, start, [start])]
visited = {}
nodes = 0
while pq:
    total_cost, node, path = heapq.heappop(pq)
    nodes += 1
    if node == goal:
        print("Path:", " -> ".join(path))
        print("Total Cost:", total_cost, "km")
        print("Nodes Explored:", nodes)
        break
    if node not in visited or total_cost < visited[node]:
        visited[node] = total_cost
        for neighbor, edge_cost in graph[node]:
            heapq.heappush(
                pq,
                (
                    total_cost + edge_cost,
                    neighbor,
                    path + [neighbor]
                )
            )


